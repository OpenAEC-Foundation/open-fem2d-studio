{
  "name": "@openaec/ui-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives the running Open FEM2D Studio app via Playwright, so Claude can screenshot, click ribbon buttons, inspect DOM and read console.",
  "type": "module",
  "private": true,
  "bin": {
    "openaec-ui-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "start": "node dist/index.js",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
