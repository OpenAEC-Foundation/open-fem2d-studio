            {
              "id": "phi_lt",
              "titel": "Hulpgrootheid Φ_LT",
              "symbol": "\\Phi_{LT}",
              "article": "art. 6.3.2.3 (6.57)",
              "formula_latex": "\\Phi_{LT} = 0{,}5 \\left[ 1 + \\alpha_{LT} \\left( \\bar{\\lambda}_{LT} - \\bar{\\lambda}_{LT,0} \\right) + \\beta \\cdot \\bar{\\lambda}_{LT}^2 \\right]",
              "ingevuld_latex": "\\Phi_{LT} = 0{,}5 \\left[ 1 + 0{,}49 \\left( 0{,}907 - 0{,}4 \\right) + 0{,}75 \\cdot 0{,}907^2 \\right]",
