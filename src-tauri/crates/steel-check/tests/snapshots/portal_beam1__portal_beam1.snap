                  "unit": "mm"
                },
                {
                  "symbol": "C_2",
                  "value": -0.0,
                  "unit": "-"
                }
              ],
              "value": 7.57977825473234,
              "unit": "-",
              "notes": [
                "Let op de haakjes: de term π·C₂·S/L_kip staat BUITEN de wortel. Bij een belasting boven het zwaartepunt is C₂ negatief, en die losse term verlaagt C dan — en daarmee M_cr."
              ]
            },
            {
              "id": "k_red",
              "titel": "Reductiefactor voor de vervormbaarheid van het lijf",
              "symbol": "k_{red}",
              "article": "NB.NB.7",
              "formula_latex": "\\frac{h}{t_w} \\le 75 \\;\\Rightarrow\\; k_{red} = 1{,}0",
              "ingevuld_latex": "\\frac{350}{14} = 25 \\le 75 \\;\\Rightarrow\\; k_{red} = 1{,}0",
              "variables": [
