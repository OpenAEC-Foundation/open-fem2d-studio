              "ingevuld_latex": "\\chi_{LT} = \\min\\left( \\frac{1}{0{,}933 + \\sqrt{0{,}933^2 - 0{,}75 \\cdot 0{,}907^2}} \\,;\\, 1{,}0 \\,;\\, \\frac{1}{0{,}907^2} \\right)",
