              "article": "NB.NB.4.3",
              "formula_latex": "L_{kip} = \\left( 1{,}4 - 0{,}8 \\cdot \\beta \\right) \\cdot L_{st}",
              "ingevuld_latex": "L_{kip} = \\left( 1{,}4 - 0{,}8 \\cdot 1 \\right) \\cdot 1667",
              "variables": [
