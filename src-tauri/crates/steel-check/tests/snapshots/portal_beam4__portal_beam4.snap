              ],
              "value": 1.0,
              "unit": "-",
              "notes": [
                "Bilineair geïnterpoleerd uit figuur NB.NB.5 — C₁ bij gelijkmatig verdeelde belasting met eindmomenten — op het raster β = −1,0 … +1,0 in stappen van 0,5 en B* = 0,00 … 1,00 in stappen van 0,05. De uiteinden van dat raster zijn verankerd op tabel NB.NB.1: C₁ = 1,13 bij B* = 0 en C₁ = min(1,75 − 1,05·β + 0,3·β² ; 2,30) bij B* = 1."
              ]
            },
            {
              "id": "c2_tabel",
              "titel": "Belastingfactor C₂ uit de figuur",
              "symbol": "C_{2,tabel}",
