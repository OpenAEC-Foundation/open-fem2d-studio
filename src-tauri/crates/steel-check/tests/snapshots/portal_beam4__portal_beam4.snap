              "formula_latex": "C_2 = -\\,C_{2,tabel} \\cdot \\frac{z_a}{\\left( h - t_f \\right)/2}",
              "ingevuld_latex": "C_2 = -\\,0 \\cdot \\frac{0}{\\left( 300 - 19 \\right)/2}",
              "variables": [
