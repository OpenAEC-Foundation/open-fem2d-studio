              "formula_latex": "C_{2,tabel} = f_{NB.NB.6}\\left( \\beta \\,;\\, \\left| B^* \\right| \\right)",
              "ingevuld_latex": "C_{2,tabel} = f_{NB.NB.6}\\left( 1 \\,;\\, 1 \\right)",
              "variables": [
